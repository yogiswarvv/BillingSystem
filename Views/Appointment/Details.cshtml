@model BillingSystem.ViewModels.AppointmentDetailsVM

@{
    ViewData["Title"] = "Appointment Details";
}

<div class="container py-4">
    <div class="row">
        <div class="col-md-10 mx-auto">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="text-primary fw-bold"><i class="bi bi-info-circle"></i> Appointment Details</h2>
                <a asp-controller="Patient" asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back to Dashboard</a>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0">Patient & Doctor Information</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 border-end">
                            <h6 class="text-muted text-uppercase small">Patient</h6>
                            <h4 class="mb-3">@Model.Appointment.Patient.FullName</h4>
                            <p class="mb-1"><i class="bi bi-calendar"></i> @Model.Appointment.AppointmentDate.ToLongDateString()</p>
                            <p class="mb-1"><i class="bi bi-clock"></i> @Model.Appointment.AppointmentTime.ToString(@"hh\:mm")</p>
                        </div>
                        <div class="col-md-6 ps-md-4">
                            <h6 class="text-muted text-uppercase small">Assigned Doctor</h6>
                            <h4 class="mb-3">@Model.Appointment.DoctorName</h4>
                            <p class="mb-1"><i class="bi bi-tag"></i> Reason: @(Model.Appointment.Reason ?? "Not specified")</p>
                            <p class="mb-0">Status: <span class="badge bg-info">@Model.Appointment.Status</span></p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Lab Orders Card -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-light d-flex justify-content-between align-items-center py-3">
                    <h5 class="mb-0"><i class="bi bi-clipboard-pulse"></i> Lab Orders</h5>
                    <a asp-controller="LabOrder" asp-action="Create" asp-route-appointmentId="@Model.Appointment.AppointmentId" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)" class="btn btn-warning btn-sm fw-bold">
                        <i class="bi bi-plus-circle"></i> Order Multiple Tests
                    </a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light text-secondary">
                                <tr>
                                    <th class="ps-4">Test Name</th>
                                    <th>Status</th>
                                    <th>Results</th>

                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.LabOrders.Any())
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-4 text-muted small">No lab tests ordered for this appointment.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var lab in Model.LabOrders)
                                    {
                                        <tr>
                                            <td class="ps-4 fw-bold">@lab.TestName</td>
                                            <td>
                                                <span class="badge @(lab.Status == "Pending" ? "bg-warning text-dark" : "bg-success")">@lab.Status</span>
                                                @if(lab.IsPaid) { <span class="badge bg-success ms-1">Paid</span> } else { <span class="badge bg-danger ms-1">Unpaid</span> }
                                            </td>
                                            <td>@(lab.Results ?? "Awaiting Results")</td>

                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Prescriptions Card -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-light d-flex justify-content-between align-items-center py-3">
                    <h5 class="mb-0"><i class="bi bi-capsule"></i> Prescriptions & Pharmacy</h5>
                    <a asp-controller="Prescription" asp-action="Create" asp-route-appointmentId="@Model.Appointment.AppointmentId" class="btn btn-success btn-sm fw-bold">
                        <i class="bi bi-plus-circle"></i> Add Medication
                    </a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light text-secondary">
                                <tr>
                                    <th class="ps-4">Medicine Name</th>
                                    <th>Suggested</th>
                                    <th>Patient Choice</th>
                                    <th>Status</th>

                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.Prescriptions.Any())
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-4 text-muted small">No medications prescribed for this appointment.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var pre in Model.Prescriptions)
                                    {
                                        <tr>
                                            <td class="ps-4">
                                                <div class="fw-bold">@pre.Medicine.Name</div>
                                                <small class="text-muted">@pre.Medicine.DosageStrength</small>
                                            </td>
                                            <td>@pre.SuggestedQuantity</td>
                                            <td class="fw-bold text-primary">@pre.ActualQuantity</td>
                                            <td>
                                                <span class="badge @(pre.Status == "Suggested" ? "bg-warning text-dark" : "bg-success")">@pre.Status</span>
                                                @if(pre.IsPaid) { <span class="badge bg-success ms-1">Paid</span> } else { <span class="badge bg-danger ms-1">Unpaid</span> }
                                            </td>

                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
