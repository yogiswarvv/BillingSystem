@model BillingSystem.ViewModels.AppointmentVM

@{
    ViewData["Title"] = "Schedule Appointment";
}

<div class="container py-4">
    <div class="row">
        <div class="col-md-6 mx-auto">
            <div class="card shadow border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0"><i class="bi bi-calendar-plus"></i> Schedule Appointment</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="PatientId" class="form-label fw-bold"></label>
                            <select asp-for="PatientId" class="form-select select2" asp-items="Model.Patients">
                                <option value="">-- Select Patient --</option>
                            </select>
                            <span asp-validation-for="PatientId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DoctorId" class="form-label fw-bold"></label>
                            <select asp-for="DoctorId" class="form-select" asp-items="Model.Doctors">
                                <option value="">-- Select Doctor --</option>
                            </select>
                            <span asp-validation-for="DoctorId" class="text-danger"></span>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="AppointmentDate" class="form-label fw-bold"></label>
                                <input asp-for="AppointmentDate" class="form-control" type="date" min="@DateTime.Now.ToString("yyyy-MM-dd")" />
                                <span asp-validation-for="AppointmentDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="AppointmentTime" class="form-label fw-bold"></label>
                                <select asp-for="AppointmentTime" class="form-select" id="timeSlotSelect">
                                    <option value="">-- Select Slot --</option>
                                </select>
                                <span asp-validation-for="AppointmentTime" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Reason" class="form-label fw-bold"></label>
                            <textarea asp-for="Reason" class="form-control" rows="3" placeholder="Reason for visit..."></textarea>
                            <span asp-validation-for="Reason" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">Schedule Now</button>
                            <a asp-controller="Patient" asp-action="Index" class="btn btn-outline-secondary">Back to Dashboard</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        $(document).ready(function () {
            function loadSlots() {
                var doctorId = $('#DoctorId').val();
                var date = $('#AppointmentDate').val();
                var slotSelect = $('#timeSlotSelect');

                if (doctorId && date) {
                    slotSelect.empty().append('<option value="">Loading slots...</option>');
                    
                    $.get('@Url.Action("GetAvailableSlots", "Appointment")', { doctorId: doctorId, date: date }, function (data) {
                        slotSelect.empty().append('<option value="">-- Select Slot --</option>');
                        if (data.length === 0) {
                            slotSelect.append('<option value="">No available slots for this date</option>');
                            if ($('#AppointmentDate').val() === '@DateTime.Now.ToString("yyyy-MM-dd")') {
                                slotSelect.append('<option value="" disabled>All slots for today have passed.</option>');
                            }
                        } else {
                            $.each(data, function (index, slot) {
                                slotSelect.append($('<option></option>').val(slot.time).text(slot.display));
                            });
                        }
                    });
                } else {
                    slotSelect.empty().append('<option value="">-- Select Slot --</option>');
                }
            }

            $('#DoctorId, #AppointmentDate').change(loadSlots);

            // Trigger initial load if values exist
            if ($('#DoctorId').val() && $('#AppointmentDate').val()) {
                loadSlots();
            }
        });
    </script>
}
