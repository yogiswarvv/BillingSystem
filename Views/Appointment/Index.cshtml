@model BillingSystem.ViewModels.AppointmentDashboardVM

@{
    ViewData["Title"] = "Appointment Dashboard";
}

<div class="container py-4">
    <!-- Header & Filter -->
    <div class="row align-items-center mb-4 g-3">
        <div class="col-md-6">
            <h2 class="fw-bold text-primary mb-0"><i class="bi bi-calendar-event"></i> Appointments</h2>
            <p class="text-muted small mb-0">Manage doctor schedules and patient visits.</p>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm border-0 rounded-pill">
                <div class="card-body p-2 d-flex align-items-center">
                    <form method="get" class="d-flex w-100 gap-2 px-2">
                        <select name="doctorId" class="form-select border-0 bg-transparent" asp-items="Model.Doctors" onchange="this.form.submit()">
                            <option value="">All Doctors</option>
                        </select>
                        <a asp-action="Create" class="btn btn-primary rounded-pill px-4 fw-bold text-nowrap">
                            <i class="bi bi-plus-lg"></i> New Appt
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Tabs Navigation -->
    <ul class="nav nav-pills mb-4 gap-2" id="pills-tab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active rounded-pill fw-bold" id="pills-scheduled-tab" data-bs-toggle="pill" data-bs-target="#pills-scheduled" type="button" role="tab">
                Scheduled <span class="badge bg-white text-primary ms-2 rounded-pill">@Model.ScheduledAppointments.Count</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill fw-bold" id="pills-completed-tab" data-bs-toggle="pill" data-bs-target="#pills-completed" type="button" role="tab">
                Completed <span class="badge bg-secondary ms-2 rounded-pill text-white">@Model.CompletedAppointments.Count</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill fw-bold" id="pills-cancelled-tab" data-bs-toggle="pill" data-bs-target="#pills-cancelled" type="button" role="tab">
                Cancelled <span class="badge bg-danger bg-opacity-75 ms-2 rounded-pill text-white">@Model.CancelledAppointments.Count</span>
            </button>
        </li>
    </ul>

    <!-- Tabs Content -->
    <div class="tab-content" id="pills-tabContent">
        
        <!-- Tab 1: Scheduled Appointments -->
        <div class="tab-pane fade show active" id="pills-scheduled" role="tabpanel">
            <div class="card shadow border-0" style="border-radius: 20px;">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-primary text-white">
                                <tr>
                                    <th class="ps-4 py-3">Patient</th>
                                    <th class="py-3">Doctor</th>
                                    <th class="py-3">Date & Time</th>
                                    <th class="py-3">Reason</th>
                                    <th class="text-end pe-4 py-3">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.ScheduledAppointments.Any())
                                {
                                    <tr><td colspan="5" class="text-center py-5 text-muted">No scheduled appointments found.</td></tr>
                                }
                                @foreach (var appt in Model.ScheduledAppointments)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="fw-bold">@appt.PatientName</div>
                                            <small class="text-muted">ID: #@appt.AppointmentId</small>
                                        </td>
                                        <td><span class="badge bg-info bg-opacity-10 text-info rounded-pill px-3">@appt.DoctorName</span></td>
                                        <td>
                                            <div class="fw-bold">@appt.AppointmentDate.ToString("dd MMM yyyy")</div>
                                            <small class="text-muted">@appt.AppointmentTime.ToString(@"hh\:mm") @(DateTime.Today.Add(appt.AppointmentTime).ToString("tt"))</small>
                                        </td>
                                        <td class="small text-truncate" style="max-width: 200px;">@appt.Reason</td>
                                        <td class="text-end pe-4">
                                            <a asp-action="Details" asp-route-id="@appt.AppointmentId" class="btn btn-sm btn-outline-primary border-0 rounded-circle" title="View"><i class="bi bi-eye"></i></a>
                                            <form asp-action="Cancel" asp-route-id="@appt.AppointmentId" method="post" class="d-inline" onsubmit="return confirm('Cancel this appointment?');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger border-0 rounded-circle" title="Cancel"><i class="bi bi-x-circle"></i></button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tab 2: Completed Appointments -->
        <div class="tab-pane fade" id="pills-completed" role="tabpanel">
            <div class="card shadow border-0" style="border-radius: 20px;">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-secondary text-white">
                                <tr>
                                    <th class="ps-4 py-3">Patient</th>
                                    <th class="py-3">Doctor</th>
                                    <th class="py-3">Date & Time</th>
                                    <th class="py-3">Reason</th>
                                    <th class="text-end pe-4 py-3">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.CompletedAppointments.Any())
                                {
                                    <tr><td colspan="5" class="text-center py-5 text-muted">No past appointments found.</td></tr>
                                }
                                @foreach (var appt in Model.CompletedAppointments)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="fw-bold">@appt.PatientName</div>
                                            <small class="text-muted">ID: #@appt.AppointmentId</small>
                                        </td>
                                        <td><span class="badge bg-secondary bg-opacity-10 text-dark rounded-pill px-3">@appt.DoctorName</span></td>
                                        <td>
                                            <div class="fw-bold text-muted">@appt.AppointmentDate.ToString("dd MMM yyyy")</div>
                                            <small class="text-muted">@appt.AppointmentTime.ToString(@"hh\:mm") @(DateTime.Today.Add(appt.AppointmentTime).ToString("tt"))</small>
                                        </td>
                                        <td class="text-muted small">@appt.Reason</td>
                                        <td class="text-end pe-4">
                                            <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3">Completed</span>
                                            <a asp-action="Details" asp-route-id="@appt.AppointmentId" class="btn btn-sm btn-link text-muted ms-2"><i class="bi bi-info-circle"></i></a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tab 3: Cancelled Appointments -->
        <div class="tab-pane fade" id="pills-cancelled" role="tabpanel">
            <div class="card shadow border-0" style="border-radius: 20px;">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-danger text-white">
                                <tr>
                                    <th class="ps-4 py-3">Patient</th>
                                    <th class="py-3">Doctor</th>
                                    <th class="py-3">Original Date</th>
                                    <th class="py-3">Status</th>
                                    <th class="text-end pe-4 py-3">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.CancelledAppointments.Any())
                                {
                                    <tr><td colspan="5" class="text-center py-5 text-muted">No cancelled appointments.</td></tr>
                                }
                                @foreach (var appt in Model.CancelledAppointments)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="fw-bold text-muted text-decoration-line-through">@appt.PatientName</div>
                                        </td>
                                        <td><span class="text-muted">@appt.DoctorName</span></td>
                                        <td class="text-muted">@appt.AppointmentDate.ToString("dd MMM yyyy")</td>
                                        <td><span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3">Cancelled</span></td>
                                        <td class="text-end pe-4">
                                            <a asp-action="Details" asp-route-id="@appt.AppointmentId" class="btn btn-sm btn-outline-secondary border-0 rounded-circle"><i class="bi bi-eye"></i></a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .nav-pills .nav-link {
        color: #6c757d;
        background-color: #f8f9fa;
        border: 1px solid #e9ecef;
        padding: 10px 20px;
        transition: all 0.2s ease;
    }
    .nav-pills .nav-link:hover {
        background-color: #e2e6ea;
        transform: translateY(-2px);
    }
    .nav-pills .nav-link.active {
        background-color: #0d6efd;
        color: white;
        box-shadow: 0 4px 6px rgba(13, 110, 253, 0.2);
    }
</style>
