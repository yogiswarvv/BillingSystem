@model IEnumerable<BillingSystem.DTOs.AppointmentListDto>

@{
    ViewData["Title"] = "Appointments";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <h2 class="text-primary fw-bold"><i class="bi bi-calendar-check"></i> Appointments</h2>
            <a asp-action="Create" class="btn btn-primary btn-lg shadow-sm">
                <i class="bi bi-calendar-plus"></i> Schedule New
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-secondary">
                        <tr>
                            <th class="ps-4">Patient</th>
                            <th>Date & Time</th>
                            <th>Doctor</th>
                            <th>Reason</th>
                            <th>Status</th>
                            <th>Labs</th>
                            <th class="text-center pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var appt in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">@appt.PatientName</td>
                                <td>
                                    <div>@appt.AppointmentDate.ToShortDateString()</div>
                                    <small class="text-muted">@appt.AppointmentTime.ToString(@"hh\:mm")</small>
                                </td>
                                <td>@appt.DoctorName</td>
                                <td class="text-truncate" style="max-width: 200px;">@appt.Reason</td>
                                <td>
                                    <span class="badge @(appt.Status == "Scheduled" ? "bg-info" : (appt.Status == "Completed" ? "bg-success" : "bg-danger"))">
                                        @appt.Status
                                    </span>
                                </td>
                                <td>
                                    @if(appt.LabOrderCount > 0)
                                    {
                                        <span class="badge rounded-pill bg-warning text-dark">@appt.LabOrderCount Tests</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">None</span>
                                    }
                                </td>
                                <td class="text-center pe-4">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@appt.AppointmentId" class="btn btn-outline-secondary" title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        @if(appt.Status == "Scheduled")
                                        {
                                            <a asp-controller="LabOrder" asp-action="Create" asp-route-appointmentId="@appt.AppointmentId" class="btn btn-outline-warning" title="Order Lab">
                                                <i class="bi bi-clipboard-pulse"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
