@model BillingSystem.ViewModels.BillGenerationPreviewViewModel

<div class="card shadow border-0 overflow-hidden">
    <div class="card-header bg-success text-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold"><i class="bi bi-file-earmark-spreadsheet"></i> Itemized Statement</h5>
        <span class="badge bg-white text-success fs-6">Auto-Generated</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 py-3">Description</th>
                        <th class="text-end py-3">Category</th>
                        <th class="text-end pe-4 py-3">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items.Where(i => i.Amount > 0))
                    {
                        <tr>
                            <td class="ps-4 py-3">@item.Description</td>
                            <td class="text-end"><span class="badge bg-light text-dark border">@item.Type</span></td>
                            <td class="text-end pe-4 fw-bold">@item.Amount.ToString("C")</td>
                        </tr>
                    }
                    
                    @if (Model.InsuranceDeduction > 0 || Model.Discounts > 0)
                    {
                        <tr class="bg-light bg-opacity-50">
                            <td colspan="3" class="ps-4 py-1 small text-muted text-uppercase tracking-wider fw-bold">Adjustments & Discounts</td>
                        </tr>
                        @foreach (var item in Model.Items.Where(i => i.Amount < 0))
                        {
                            <tr class="text-success fw-bold">
                                <td class="ps-4 py-2"><i class="bi bi-dash-circle me-1"></i> @item.Description</td>
                                <td class="text-end">@item.Type</td>
                                <td class="text-end pe-4">-@Math.Abs(item.Amount).ToString("C")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer bg-white border-top-0 p-4">
        <div class="row">
            <div class="col-md-6 offset-md-6">
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Gross Total:</span>
                    <span class="fw-bold">@Model.GrossTotal.ToString("C")</span>
                </div>
                <div class="d-flex justify-content-between mb-2 text-success">
                    <span>Total Deductions:</span>
                    <span class="fw-bold">-@((Model.Discounts + Model.InsuranceDeduction).ToString("C"))</span>
                </div>
                <div class="d-flex justify-content-between mb-3 text-muted border-bottom pb-2">
                    <span>Tax (8%):</span>
                    <span class="fw-bold">+@Model.TaxAmount.ToString("C")</span>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="fs-4 fw-bold">Total Payable:</span>
                    <span class="fs-3 fw-bold text-success">@Model.FinalAmount.ToString("C")</span>
                </div>
            </div>
        </div>
    </div>
</div>
