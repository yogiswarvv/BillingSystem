@model BillingSystem.ViewModels.BillGenerationPreviewViewModel

<div class="card shadow border-success">
    <div class="card-header bg-success text-white">
        <h5 class="mb-0"><i class="bi bi-file-earmark-check"></i> Bill Preview</h5>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped mb-0">
             <thead class="table-light">
                <tr>
                    <th>Description</th>
                    <th class="text-end">Amount</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Consultation Fee</td>
                    <td class="text-end">@Model.ConsultationFee.ToString("C")</td>
                </tr>
                @foreach(var item in Model.Items.Where(i => i.Type == BillingSystem.Models.BillItemType.Service))
                {
                     <tr>
                        <td><small>@item.Description</small></td>
                        <td class="text-end">@item.Amount.ToString("C")</td>
                    </tr>
                }
                @if(Model.AdmitAmount > 0)
                {
                     <tr>
                        <td>Admission Charges</td>
                        <td class="text-end">@Model.AdmitAmount.ToString("C")</td>
                    </tr>
                }
               
                 <tr>
                    <td class="fw-bold">Gross Total</td>
                    <td class="text-end fw-bold">@Model.GrossTotal.ToString("C")</td>
                </tr>

                @if(Model.Discounts > 0)
                {
                    <tr class="text-success">
                        <td>Discounts Applied</td>
                        <td class="text-end">-@Model.Discounts.ToString("C")</td>
                    </tr>
                }
                
                @if(Model.InsuranceDeduction > 0)
                {
                    <tr class="text-primary">
                        <td>Insurance Coverage</td>
                        <td class="text-end">-@Model.InsuranceDeduction.ToString("C")</td>
                    </tr>
                }

                 <tr>
                    <td>Tax (8%)</td>
                    <td class="text-end">@Model.TaxAmount.ToString("C")</td>
                </tr>
            </tbody>
            <tfoot class="bg-dark text-white">
                <tr>
                    <td class="fs-5">Net Payable</td>
                     <td class="text-end fs-4 fw-bold">@Model.FinalAmount.ToString("C")</td>
                </tr>
            </tfoot>
        </table>
    </div>
    <div class="card-footer bg-light text-end">
         <button type="button" id="btnConfirmBill" class="btn btn-success btn-lg w-100">
            <i class="bi bi-check-circle-fill"></i> Confirm & Generate Bill
        </button>
        <div class="text-muted small mt-2 text-center">
            Once confirmed, bill cannot be edited.
        </div>
    </div>
</div>
