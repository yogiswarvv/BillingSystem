@model IEnumerable<BillingSystem.Models.Bill>
@{
    ViewData["Title"] = "Past Bills";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Billing History</h2>
            <p class="text-muted">Patient: <strong>@ViewBag.PatientName</strong> (ID: #@ViewBag.PatientId)</p>
        </div>
        <button onclick="window.close()" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
             <i class="bi bi-x-circle"></i> Close Window
        </button>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="card shadow-sm border-0 py-5 text-center">
            <div class="card-body">
                <div class="p-3 bg-light rounded-circle d-inline-block mb-3">
                    <i class="bi bi-info-circle fs-1 text-info"></i>
                </div>
                <h5>No billing history found for this patient.</h5>
                <p class="text-muted">All generated bills for this patient will appear here.</p>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 overflow-hidden" style="border-radius: 12px;">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-dark text-white">
                        <tr>
                            <th class="ps-4 py-3">Bill Date</th>
                            <th class="py-3">Bill ID</th>
                            <th class="py-3 text-end">Gross Amount</th>
                            <th class="py-3 text-end">Insurance</th>
                            <th class="py-3 text-end">Net Payable</th>
                            <th class="py-3 text-center">Status</th>
                            <th class="text-end pe-4 py-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var bill in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold">@bill.BillDate.ToString("dd MMM yyyy")</div>
                                    <small class="text-muted">@bill.BillDate.ToString("hh:mm tt")</small>
                                </td>
                                <td><span class="badge bg-light text-dark border">#@bill.BillId</span></td>
                                <td class="text-end">₹@bill.TotalAmount.ToString("N2")</td>
                                <td class="text-end">
                                    @if(bill.InsuranceDeduction > 0)
                                    {
                                        <span class="text-success small">-₹@bill.InsuranceDeduction.ToString("N2")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">--</span>
                                    }
                                </td>
                                <td class="text-end fw-bold text-dark">₹@bill.FinalAmount.ToString("N2")</td>
                                <td class="text-center">
                                    @if (bill.Status == BillingSystem.Models.BillStatus.Paid)
                                    {
                                        <span class="badge rounded-pill bg-success-subtle text-success border border-success px-3">
                                            <i class="bi bi-check-circle-fill me-1"></i> Paid
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-danger-subtle text-danger border border-danger px-3">
                                            <i class="bi bi-clock-history me-1"></i> Unpaid
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group">
                                        <button class="btn btn-sm btn-outline-primary"><i class="bi bi-printer"></i></button>
                                        <button class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye"></i></button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<style>
    .bg-success-subtle { background-color: #d1e7dd !important; }
    .bg-danger-subtle { background-color: #f8d7da !important; }
    .table-hover tbody tr:hover { background-color: #f8f9fa; }
</style>
