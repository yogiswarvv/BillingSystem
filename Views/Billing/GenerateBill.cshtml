@model BillingSystem.ViewModels.BillGenerationViewModel

@{
    ViewData["Title"] = "Generate Bill";
}

<div class="row">
    <!-- Left Panel: Bill Generation Form -->
    <div class="col-md-7">
        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"><i class="bi bi-receipt-cutoff"></i> New Bill Generation</h4>
            </div>
            <div class="card-body">
                <form id="billingForm" asp-action="SubmitBill" method="post">
                    <div class="text-danger" asp-validation-summary="ModelOnly"></div>
                    <input type="hidden" asp-for="PatientId" id="hdnPatientId" />
                    
                    <!-- 1. Patient Search -->
                    <div class="mb-4 border-bottom pb-4">
                        <h5 class="text-muted mb-3"><i class="bi bi-person-bounding-box"></i> Patient Lookup</h5>
                        
                        <div class="input-group mb-3">
                            <input type="text" id="txtMobileSearch" class="form-control form-control-lg" placeholder="Enter Mobile Number" />
                            <button type="button" class="btn btn-outline-primary" id="btnSearch">
                                <i class="bi bi-search"></i> Search User
                            </button>
                        </div>
                        <span id="searchError" class="text-danger"></span>

                        <div id="patientInfoPanel" class="alert alert-secondary d-none">
                            <div class="row">
                                <div class="col-md-6">
                                    <strong>Name:</strong> <span id="lblPatientName"></span>
                                </div>
                                <div class="col-md-3">
                                    <strong>Age:</strong> <span id="lblAge"></span>
                                </div>
                                <div class="col-md-3">
                                    <span id="lblSeniorBadge" class="badge bg-success d-none">Senior Citizen</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 2. Services Selection -->
                     <div class="mb-4 border-bottom pb-4">
                        <h5 class="text-muted mb-3"><i class="bi bi-activity"></i> Services & Tests</h5>
                        <div class="mb-3">
                            <label asp-for="SelectedServiceIds" class="form-label">Select Services (Hold Ctrl for multiple)</label>
                            <select asp-for="SelectedServiceIds" asp-items="Model.AvailableServices" class="form-select" size="5" multiple>
                            </select>
                            <small class="text-muted">Select all applicable tests and services.</small>
                        </div>
                    </div>

                    <!-- 3. Admission Details -->
                    <div class="mb-4 border-bottom pb-4">
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" asp-for="IsAdmitted" id="chkAdmitted">
                            <label class="form-check-label fw-bold" for="chkAdmitted">Patient Admitted?</label>
                        </div>
                        
                        <div id="admissionFields" class="d-none ps-4 border-start border-3 border-warning">
                            <div class="mb-3 w-50">
                                <label asp-for="AdmitDays" class="form-label">Number of Days</label>
                                <input asp-for="AdmitDays" class="form-control" min="0" />
                            </div>
                        </div>
                    </div>

                    <!-- 4. Insurance Details -->
                    <div class="mb-4">
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" asp-for="HasInsurance" id="chkInsurance">
                            <label class="form-check-label fw-bold" for="chkInsurance">Apply Insurance?</label>
                        </div>
                        
                         <p class="text-muted small fst-italic ms-4">
                            * Uses existing insurance policy linked to patient.
                        </p>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <button type="button" id="btnPreview" class="btn btn-warning me-md-2 btn-lg">
                            <i class="bi bi-calculator"></i> Calculate Preview
                        </button>
                    </div>
                    
                    <!-- Hidden Submit trigger -->
                     <button type="submit" id="btnRealSubmit" class="d-none"></button>
                </form>
            </div>
        </div>
    </div>

    <!-- Right Panel: Bill Preview -->
    <div class="col-md-5">
        <div class="sticky-top" style="top: 20px; z-index: 1;">
            <div id="previewContainer">
                <div class="alert alert-info text-center py-5">
                    <i class="bi bi-file-text display-4"></i>
                    <p class="mt-3">Fill form and click "Calculate Preview" to see bill details here.</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            // 1. Patient Search
            $('#btnSearch').click(function() {
                var mobile = $('#txtMobileSearch').val();
                $('#searchError').text('');
                
                if(!mobile) {
                    $('#searchError').text('Please enter mobile number.');
                    return;
                }

                $.get('/PatientLookup/SearchByMobile', { mobile: mobile })
                    .done(function(data) {
                        $('#hdnPatientId').val(data.id);
                        $('#lblPatientName').text(data.name);
                        $('#lblAge').text(data.age);
                        
                        if(data.isSenior) $('#lblSeniorBadge').removeClass('d-none');
                        else $('#lblSeniorBadge').addClass('d-none');

                        $('#patientInfoPanel').removeClass('d-none');
                    })
                    .fail(function() {
                         $('#hdnPatientId').val('');
                         $('#patientInfoPanel').addClass('d-none');
                         $('#searchError').text('Patient not found.');
                    });
            });

            // 2. Toggle Fields
            $('#chkAdmitted').change(function() {
                if($(this).is(':checked')) $('#admissionFields').removeClass('d-none');
                else $('#admissionFields').addClass('d-none');
            });

            // 3. Preview Logic
            $('#btnPreview').click(function() {
                var patientId = $('#hdnPatientId').val();
                if(!patientId) {
                    alert('Please search and select a patient first.');
                    return;
                }

                var formData = $('#billingForm').serialize();

                $.post('/Billing/GeneratePreview', formData)
                    .done(function(partialView) {
                        $('#previewContainer').html(partialView);
                    })
                    .fail(function(xhr) {
                        $('#previewContainer').html('<div class="alert alert-danger">Error calculating bill: ' + xhr.responseText + '</div>');
                    });
            });
            
            // 4. Confirm Submit (Delegated because button inside partial)
            $(document).on('click', '#btnConfirmBill', function() {
                // Trigger real form submit
                 $('#billingForm').submit();
            });
        });
    </script>
}
