@model BillingSystem.ViewModels.HomeDashboardVM

@{
    ViewData["Title"] = "LifeStream | Hospital Dashboard";
}

<div class="container-fluid py-4">
    <div class="row mb-4 align-items-center">
        <div class="col-md-8">
            <h1 class="display-6 fw-bold text-primary mb-1">Hospital Management Dashboard</h1>
            <p class="text-muted mb-0">Unified Billing & EHR Overview | <span class="badge bg-light text-dark border">Live Data Tracking</span></p>
        </div>
        <div class="col-md-4 text-md-end">
            <div class="bg-white p-2 rounded shadow-sm d-inline-block border">
                <span class="text-muted small">Server Time:</span> <strong>@DateTime.Now.ToString("dd MMM, hh:mm tt")</strong>
            </div>
        </div>
    </div>

    <!-- Live Stats Grid -->
    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="card bg-primary text-white shadow border-0 h-100 transition-up">
                <div class="card-body">
                    <h6 class="text-uppercase small mb-2 opacity-75">Total Patients</h6>
                    <h2 class="mb-1">@Model.TotalPatients.ToString("N0")</h2>
                    <p class="small mb-0 opacity-75">
                        <i class="bi bi-person-plus-fill"></i> @Model.NewPatientsToday new today
                    </p>
                    <i class="bi bi-people position-absolute end-0 top-0 m-3 fs-1 opacity-25"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white shadow border-0 h-100 transition-up">
                <div class="card-body">
                    <h6 class="text-uppercase small mb-2 opacity-75">Total Revenue (All Time)</h6>
                    @{
                        bool isAuth = User.Identity?.IsAuthenticated == true;
                        string Mask(decimal amt) => isAuth ? amt.ToString("N0") : "XXXXXX";
                    }
                    <h2 class="mb-1">₹@Mask(Model.TotalRevenue)</h2>
                    <p class="small mb-0 opacity-75">
                        <i class="bi bi-graph-up"></i> ₹@Mask(Model.TodaysRevenue) collected today
                    </p>
                    <i class="bi bi-wallet2 position-absolute end-0 top-0 m-3 fs-1 opacity-25"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-white shadow border-0 h-100 transition-up">
                <div class="card-body">
                    <h6 class="text-uppercase small mb-2 opacity-75">Pending Lab Orders</h6>
                    <h2 class="mb-1">@Model.PendingLabOrders</h2>
                    <p class="small mb-0 opacity-75">
                        <i class="bi bi-clock"></i> Action required
                    </p>
                    <i class="bi bi-clipboard-pulse position-absolute end-0 top-0 m-3 fs-1 opacity-25"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-dark shadow border-0 h-100 transition-up">
                <div class="card-body">
                    <h6 class="text-uppercase small mb-2 opacity-75">Today's Appointments</h6>
                    <h2 class="mb-1">@Model.AppointmentsToday</h2>
                    <p class="small mb-0 opacity-75">
                        <i class="bi bi-check2-all"></i> @Model.CompletedAppointmentsToday completed
                    </p>
                    <i class="bi bi-calendar-event position-absolute end-0 top-0 m-3 fs-1 opacity-25"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-6">
            <div class="card shadow-sm h-100 border-0 bg-white" style="border-radius: 15px;">
                <div class="card-header bg-white border-bottom-0 pt-4 px-4">
                    <h5 class="fw-bold mb-0"><i class="bi bi-lightning-charge text-warning me-2"></i> Role-Based Quick Actions</h5>
                </div>
                <div class="card-body px-4">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="list-group list-group-flush gap-2">
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-controller="Patient" asp-action="Create" class="list-group-item list-group-item-action border rounded-3 py-3 hover-shadow-sm mb-2">
                                    <div class="d-flex align-items-center">
                                        <div class="p-2 bg-primary bg-opacity-10 text-primary rounded-circle me-3">
                                            <i class="bi bi-person-plus fs-4"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold mb-0">Patient Registration</h6>
                                            <small class="text-muted">Register a new OPD/IPD patient</small>
                                        </div>
                                    </div>
                                </a>
                                <a asp-controller="Appointment" asp-action="Index" class="list-group-item list-group-item-action border rounded-3 py-3 hover-shadow-sm mb-2">
                                    <div class="d-flex align-items-center">
                                        <div class="p-2 bg-info bg-opacity-10 text-info rounded-circle me-3">
                                            <i class="bi bi-calendar-check fs-4"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold mb-0">Schedule Appointments</h6>
                                            <small class="text-muted">Manage doctor bookings and slots</small>
                                        </div>
                                    </div>
                                </a>
                            }
                            @if (User.IsInRole("Billing"))
                            {
                                <a asp-controller="Billing" asp-action="Index" class="list-group-item list-group-item-action border rounded-3 py-3 hover-shadow-sm mb-2">
                                    <div class="d-flex align-items-center">
                                        <div class="p-2 bg-success bg-opacity-10 text-success rounded-circle me-3">
                                            <i class="bi bi-receipt fs-4"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold mb-0">Billing Desk</h6>
                                            <small class="text-muted">Process payments and generate bills</small>
                                        </div>
                                    </div>
                                </a>
                            }
                            @if (User.IsInRole("Lab"))
                            {
                                <a asp-controller="LabOrder" asp-action="Index" class="list-group-item list-group-item-action border rounded-3 py-3 hover-shadow-sm mb-2">
                                    <div class="d-flex align-items-center">
                                        <div class="p-2 bg-warning bg-opacity-10 text-warning rounded-circle me-3">
                                            <i class="bi bi-microscope fs-4"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold mb-0">Lab Management</h6>
                                            <small class="text-muted">Update test results and diagnostic status</small>
                                        </div>
                                    </div>
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="bi bi-lock text-muted display-4 mb-3"></i>
                            <p class="text-muted">Please log in to see authorized actions.</p>
                            <a asp-controller="Account" asp-action="Login" class="btn btn-primary rounded-pill px-4">Go to Staff Login</a>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm h-100 border-0 bg-white" style="border-radius: 15px;">
                <div class="card-header bg-white border-bottom-0 pt-4 px-4">
                    <h5 class="fw-bold mb-0"><i class="bi bi-search text-primary me-2"></i> Clinical Search</h5>
                </div>
                <div class="card-body px-4">
                    <p class="text-muted small">Search patient history across departments using Unique ID.</p>
                    <form asp-controller="PatientHistory" asp-action="Index" method="get" class="mt-3">
                        <div class="input-group mb-3 bg-light p-2 rounded-pill border">
                            <span class="input-group-text bg-transparent border-0"><i class="bi bi-hash text-primary"></i></span>
                            <input type="number" name="patientId" class="form-control bg-transparent border-0" placeholder="Patient ID (e.g. 1)" required />
                            @* Removed redundant Lookup button *@
                        </div>
                    </form>
                    <div class="mt-4 p-3 bg-light rounded-4">
                        <small class="text-muted d-block mb-2 text-uppercase fw-bold x-small">Search Tips:</small>
                        <ul class="x-small text-muted mb-0 ps-3">
                            <li>Higher access roles see more detailed clinical flags.</li>
                            <li>Billing staff can immediately jump to Payment Desk from here.</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .transition-up { transition: all 0.3s ease; }
    .transition-up:hover { transform: translateY(-5px); box-shadow: 0 .5rem 2rem rgba(0,0,0,.15)!important; }
</style>
