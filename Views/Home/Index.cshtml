@{
    ViewData["Title"] = "Hospital Management Dashboard";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="display-6 fw-bold text-primary">Healthcare Management Dashboard</h2>
            <p class="text-muted">Unified Billing & EHR Overview</p>
        </div>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="card bg-primary text-white shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-uppercase small mb-2">Total Patients</h6>
                    <h2 class="mb-0">2,482</h2>
                    <i class="bi bi-people position-absolute end-0 top-0 m-3 fs-1 opacity-25"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-uppercase small mb-2">Revenue Today</h6>
                    <h2 class="mb-0">₹45,200</h2>
                    <i class="bi bi-currency-dollar position-absolute end-0 top-0 m-3 fs-1 opacity-25"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-white shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-uppercase small mb-2">Pending Labs</h6>
                    <h2 class="mb-0">18</h2>
                    <i class="bi bi-clipboard-pulse position-absolute end-0 top-0 m-3 fs-1 opacity-25"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-dark shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-uppercase small mb-2">Scheduled Appts</h6>
                    <h2 class="mb-0">42</h2>
                    <i class="bi bi-calendar-event position-absolute end-0 top-0 m-3 fs-1 opacity-25"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white border-bottom-0 pt-3">
                    <h5 class="card-title"><i class="bi bi-activity text-primary"></i> Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="list-group list-group-flush">
                        <a asp-controller="Patient" asp-action="Create" class="list-group-item list-group-item-action border-0 py-3">
                            <i class="bi bi-person-plus me-3 text-primary fs-5"></i> New Patient Registration
                        </a>
                        <a asp-controller="CashierBilling" asp-action="BillingDesk" class="list-group-item list-group-item-action border-0 py-3">
                            <i class="bi bi-receipt me-3 text-success fs-5"></i> Open Billing Desk
                        </a>
                        <a href="#" class="list-group-item list-group-item-action border-0 py-3">
                            <i class="bi bi-calendar-check me-3 text-info fs-5"></i> Schedule Appointment
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white border-bottom-0 pt-3">
                    <h5 class="card-title"><i class="bi bi-search text-primary"></i> Patient Search</h5>
                </div>
                <div class="card-body text-center py-5">
                    <p class="text-muted mb-4">Search patient to view unified history or generate bills.</p>
                    <form asp-controller="PatientHistory" asp-action="Index" method="get">
                        <div class="input-group mb-3">
                            <input type="number" name="patientId" class="form-control" placeholder="Enter Patient ID (e.g. 1)" required />
                            <button class="btn btn-primary" type="submit">View History</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
