@model BillingSystem.ViewModels.PaymentViewModel
@using BillingSystem.Models

@{
    ViewData["Title"] = "Collect Payment";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-primary">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="bi bi-credit-card"></i> Collect Payment</h4>
                </div>
                <div class="card-body bg-light">
                    <div class="text-center mb-4">
                        <small class="text-muted d-block">TOTAL AMOUNT DUE</small>
                        <h1 class="display-4 fw-bold text-primary">@Model.TotalBillAmount.ToString("C")</h1>
                        <p class="badge bg-secondary">Bill #@Model.BillId</p>
                    </div>

                    <form asp-action="CollectPayment" method="post">
                        <input type="hidden" asp-for="BillId" />
                        <input type="hidden" asp-for="TotalBillAmount" />
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                         <div class="form-floating mb-3">
                            <input asp-for="PaidAmount" class="form-control fs-4 fw-bold" placeholder="Amount" value="@Model.TotalBillAmount" />
                            <label asp-for="PaidAmount">Amount Received</label>
                            <span asp-validation-for="PaidAmount" class="text-danger"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <select asp-for="PaymentMode" class="form-select" asp-items="Html.GetEnumSelectList<PaymentMode>()"></select>
                            <label asp-for="PaymentMode">Payment Mode</label>
                            <span asp-validation-for="PaymentMode" class="text-danger"></span>
                        </div>

                        <div class="form-floating mb-4" id="divTransactionRef">
                            <input asp-for="TransactionReference" class="form-control" placeholder="Ref" />
                            <label asp-for="TransactionReference">Transaction Reference (Optional)</label>
                            <span asp-validation-for="TransactionReference" class="text-danger"></span>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg">COMPLETE PAYMENT</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            function generateRef() {
                const year = new Date().getFullYear();
                const rand = Math.random().toString(36).substring(2, 7).toUpperCase();
                return 'TXN-' + year + '-' + rand;
            }

            $('#PaymentMode').change(function() {
                const selectedMode = $(this).val();
                if (selectedMode == "1") { // Cash (Value 1 from Enum)
                    $('#divTransactionRef').addClass('d-none');
                    $('#TransactionReference').val('');
                } else {
                    $('#divTransactionRef').removeClass('d-none');
                    // Only auto-fill if currently empty
                    if (!$('#TransactionReference').val()) {
                        $('#TransactionReference').val(generateRef());
                    }
                }
            });

            // Run on page load to handle initial state
            $('#PaymentMode').trigger('change');
        });
    </script>
}
