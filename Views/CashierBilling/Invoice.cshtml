@model BillingSystem.Models.Bill
@using BillingSystem.Models

@{
    Layout = null; // No layout for printable invoice
    ViewData["Title"] = "Receipt #" + Model.BillId;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Receipt @Model.BillId</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .invoice-box { padding: 40px; border: 1px solid #eee; box-shadow: 0 0 10px rgba(0, 0, 0, .05); max-width: 850px; margin: auto; background: #fff; }
        .header { border-bottom: 2px solid #0d6efd; padding-bottom: 20px; margin-bottom: 30px; }
        .hospital-name { color: #0d6efd; font-weight: 800; letter-spacing: -0.5px; }
        .table thead { background-color: #f8f9fa; border-top: 2px solid #dee2e6; }
        .table th { text-transform: uppercase; font-size: 0.8rem; letter-spacing: 0.5px; color: #6c757d; }
        @@media print {
            .no-print { display: none; }
            .invoice-box { border: none; box-shadow: none; padding: 0; max-width: 100%; margin: 0; }
            body { background-color: #fff !important; }
        }
    </style>
</head>
<body class="bg-light">
    <div class="container my-5">
        <div class="no-print text-center mb-4">
            <button onclick="window.print()" class="btn btn-primary btn-lg shadow-sm"><i class="bi bi-printer"></i> Print Receipt</button>
            <a href="@Url.Action("BillingDesk", "CashierBilling")" class="btn btn-outline-secondary btn-lg shadow-sm">Back to Desk</a>
        </div>

        <div class="invoice-box shadow-sm rounded-3">
            <div class="header d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="hospital-name mb-0">HEALTH HUB HOSPITAL</h2>
                    <p class="text-muted small mb-0">Excellence in Healthcare | 123 Wellness Way, City</p>
                </div>
                <div class="text-end">
                    <h3 class="mb-0 text-uppercase fw-bold text-primary">Receipt</h3>
                    <p class="mb-0 fw-bold">No: RCPT-@Model.BillId.ToString("D5")</p>
                    <p class="text-muted small mb-0">Date: @Model.BillDate.ToString("dd-MMM-yyyy HH:mm")</p>
                </div>
            </div>

            <div class="row mb-5">
                <div class="col-6">
                    <h6 class="text-primary text-uppercase small fw-bold mb-3">Patient Information</h6>
                    <h5 class="mb-1 fw-bold">@Model.Patient?.FullName</h5>
                    <p class="mb-0 text-dark">Age: @Model.Patient?.Age Years | Gender: @Model.Patient?.Gender</p>
                    <p class="text-muted mb-0">Contact: @Model.Patient?.MobileNumber</p>
                </div>
                <div class="col-6 text-end">
                    <h6 class="text-primary text-uppercase small fw-bold mb-3">Payment Details</h6>
                    <p class="mb-0">Status: <span class="badge @(Model.Status == BillStatus.Paid ? "bg-success" : "bg-warning text-dark") fs-6">@Model.Status</span></p>
                    @{
                        var payment = Model.Payments.OrderByDescending(p => p.PaidDate).FirstOrDefault();
                        if (payment != null)
                        {
                            <p class="mb-0 text-dark mt-1">Method: @payment.PaymentMode</p>
                            if (!string.IsNullOrEmpty(payment.TransactionRef))
                            {
                                <p class="mb-0 text-muted small">Ref: @payment.TransactionRef</p>
                            }
                        }
                    }
                    <p class="text-muted small mt-1">Generated: @DateTime.Now.ToString("dd-MMM-yyyy")</p>
                </div>
            </div>

            <table class="table table-hover mt-4">
                <thead>
                    <tr>
                        <th>Description</th>
                        <th class="text-end">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Consultation Fee</td>
                        <td class="text-end">@Model.ConsultationFee.ToString("C")</td>
                    </tr>
                    @if (Model.OptionalServicesAmount > 0)
                    {
                        <tr>
                            <td>Optional Services</td>
                            <td class="text-end">@Model.OptionalServicesAmount.ToString("C")</td>
                        </tr>
                    }
                    @if (Model.AdmitAmount > 0)
                    {
                        <tr>
                            <td>Admission Charges</td>
                            <td class="text-end">@Model.AdmitAmount.ToString("C")</td>
                        </tr>
                    }
                    
                    @* Detailed Items *@
                    @foreach (var item in Model.BillItems.Where(i => i.ItemType != BillItemType.Consultation && i.ItemType != BillItemType.Service && i.ItemType != BillItemType.Admission))
                    {
                        <tr class="@(item.Amount < 0 ? "text-success fw-bold" : "")">
                            <td>@item.Description</td>
                            <td class="text-end">@item.Amount.ToString("C")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="border-top">
                        <th class="text-end">Tax (8%)</th>
                        <th class="text-end">@Model.TaxAmount.ToString("C")</th>
                    </tr>
                    <tr class="bg-primary text-white">
                        <th class="text-end fs-5">TOTAL PAYABLE</th>
                        <th class="text-end fs-5">@Model.FinalAmount.ToString("C")</th>
                    </tr>
                </tfoot>
            </table>

            <div class="mt-5 pt-4 text-center border-top">
                <p class="mb-0 fw-bold">Thank you for choosing Health Hub!</p>
                <p class="text-muted small">This is a computer-generated invoice and doesn't require a physical signature.</p>
            </div>
        </div>
    </div>

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</body>
</html>
