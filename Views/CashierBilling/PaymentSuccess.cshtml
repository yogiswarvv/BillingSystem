@{
    ViewData["Title"] = "Payment Successful";
}

<div class="container mt-5 text-center">
    <div class="card shadow-sm mx-auto" style="max-width: 500px;">
        <div class="card-body py-5">
            <div class="mb-4 text-success">
                <i class="bi bi-check-circle-fill" style="font-size: 5rem;"></i>
            </div>
            <h2 class="card-title text-success">Payment Successful!</h2>
            <p class="card-text text-muted mb-4">The bill has been settled and receipt generated.</p>
            
            <div class="d-grid gap-2 col-8 mx-auto">
                <a href="@Url.Action("Invoice", new { billId = ViewBag.BillId })" target="_blank" class="btn btn-outline-primary"><i class="bi bi-printer"></i> Print Receipt</a>
                <a asp-action="BillingDesk" class="btn btn-primary"><i class="bi bi-arrow-repeat"></i> New Bill</a>
            </div>
        </div>
    </div>
</div>
