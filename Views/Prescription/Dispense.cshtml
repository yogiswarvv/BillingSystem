@model BillingSystem.ViewModels.PrescriptionUpdateVM

@{
    ViewData["Title"] = "Dispense Medicine";
}

<div class="container py-4">
    <div class="row">
        <div class="col-md-6 mx-auto">
            <div class="card shadow border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-bag-plus"></i> Pharmacy Dispensing</h5>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-info border-0 mb-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-0 fw-bold">@Model.MedicineName</h6>
                                <small>@Model.Dosage</small>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-light text-dark border">Suggested: @Model.SuggestedQuantity Units</span>
                            </div>
                        </div>
                    </div>

                    <form asp-action="Dispense">
                        <input type="hidden" asp-for="PrescriptionId" />
                        <input type="hidden" asp-for="MedicineName" />
                        <input type="hidden" asp-for="SuggestedQuantity" />

                        <div class="mb-3">
                            <label asp-for="ActualQuantity" class="form-label fw-bold font-monospace">PATIENT CHOICE: Actual Quantity Taken</label>
                            <input asp-for="ActualQuantity" class="form-control form-control-lg border-primary" type="number" min="0" max="100" />
                            <span asp-validation-for="ActualQuantity" class="text-danger"></span>
                            <div class="form-text text-primary small">
                                <i class="bi bi-info-circle"></i> Patients can choose to take fewer units or cancel (set to 0) based on their need.
                            </div>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg fw-bold">Update Pharmacy Record</button>
                            <a asp-controller="Appointment" asp-action="Index" class="btn btn-outline-secondary">Back to Pharmacy List</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
