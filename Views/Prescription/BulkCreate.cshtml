@model BillingSystem.ViewModels.BulkPrescriptionVM

@{
    ViewData["Title"] = "Prescribe Medications (Bulk)";
}

<div class="container py-4">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card shadow border-0">
                <div class="card-header bg-success text-white py-3">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-capsule"></i> Prescribe Medications</h5>
                </div>
                <div class="card-body p-4">
                    <div class="mb-4">
                        <span class="text-muted">Patient:</span> <strong class="fs-5">@Model.PatientName</strong>
                    </div>

                    <form asp-action="BulkCreate">
                        <input type="hidden" asp-for="AppointmentId" />
                        <input type="hidden" asp-for="PatientName" />

                        <div class="mb-4">
                            <label class="form-label fw-bold mb-3 text-uppercase small text-muted">Select Medicines and Quantities</label>
                            <div class="table-responsive">
                                <table class="table table-hover align-middle border">
                                    <thead class="bg-light">
                                        <tr>
                                            <th style="width: 50px;"></th>
                                            <th>Medicine Name</th>
                                            <th>Dosage</th>
                                            <th style="width: 150px;">Quantity</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (int i = 0; i < Model.Medicines.Count; i++)
                                        {
                                            <tr>
                                                <td>
                                                    <input type="hidden" asp-for="@Model.Medicines[i].MedicineId" />
                                                    <input type="hidden" asp-for="@Model.Medicines[i].Name" />
                                                    <input type="hidden" asp-for="@Model.Medicines[i].Dosage" />
                                                    <div class="form-check">
                                                        <input class="form-check-input" type="checkbox" asp-for="@Model.Medicines[i].IsSelected">
                                                    </div>
                                                </td>
                                                <td>
                                                    <label class="fw-bold mb-0">@Model.Medicines[i].Name</label>
                                                </td>
                                                <td>
                                                    <span class="text-muted small">@Model.Medicines[i].Dosage</span>
                                                </td>
                                                <td>
                                                    <input type="number" asp-for="@Model.Medicines[i].Quantity" class="form-control form-control-sm" min="1" max="100" />
                                                    <span asp-validation-for="@Model.Medicines[i].Quantity" class="text-danger small"></span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-success btn-lg fw-bold border-0 shadow-sm">Confirm & Save Prescriptions</button>
                            <a asp-controller="Appointment" asp-action="Details" asp-route-id="@Model.AppointmentId" class="btn btn-outline-secondary">Back to Appointment</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .transition { transition: all 0.2s ease-in-out; }
    .hover-shadow:hover { 
        background-color: #f8f9fa;
        border-color: #198754 !important;
        transform: translateY(-2px);
    }
    .cursor-pointer { cursor: pointer; }
</style>
