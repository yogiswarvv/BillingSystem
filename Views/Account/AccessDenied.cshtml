@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="mb-4">
                <i class="bi bi-exclamation-octagon text-danger display-1"></i>
            </div>
            <h1 class="fw-bold text-danger">Access Denied</h1>
            <p class="lead text-muted mb-4">You do not have permission to access this module. If you believe this is an error, please contact the System Administrator.</p>
            
            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary rounded-pill px-4">
                    <i class="bi bi-house-door me-2"></i> Return Home
                </a>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="btn btn-danger rounded-pill px-4">
                        <i class="bi bi-box-arrow-right me-2"></i> Switch User
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
