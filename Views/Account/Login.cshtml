@model BillingSystem.ViewModels.LoginVM

@{
    ViewData["Title"] = "Staff Login";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-lg border-0" style="border-radius: 20px; overflow: hidden;">
                <div class="card-header bg-primary text-white text-center py-4">
                    <h3 class="fw-bold mb-0"><i class="bi bi-shield-lock"></i> Staff Portal</h3>
                    <p class="small mb-0 opacity-75">Secure access for Admin, Billing, and Lab</p>
                </div>
                <div class="card-body p-5">
                    <form asp-action="Login" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                        
                        <div class="mb-4">
                            <label asp-for="Email" class="form-label fw-bold small text-muted text-uppercase"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0"><i class="bi bi-envelope text-primary"></i></span>
                                <input asp-for="Email" class="form-control bg-light border-0 px-3 py-2" placeholder="name@hospital.com" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger x-small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Password" class="form-label fw-bold small text-muted text-uppercase"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0"><i class="bi bi-key text-primary"></i></span>
                                <input asp-for="Password" class="form-control bg-light border-0 px-3 py-2" />
                            </div>
                            <span asp-validation-for="Password" class="text-danger x-small"></span>
                        </div>

                        <div class="mb-4 form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label small text-muted"></label>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg fw-bold rounded-pill shadow-sm py-3">
                                <i class="bi bi-box-arrow-in-right me-2"></i> Log In
                            </button>
                        </div>
                    </form>
                </div>
                <div class="card-footer bg-light text-center py-3 border-0">
                    <small class="text-muted">Default credentials provided in System Docs</small>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .x-small { font-size: 0.75rem; }
</style>
