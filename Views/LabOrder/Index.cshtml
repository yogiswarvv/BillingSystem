@model IEnumerable<BillingSystem.Models.LabOrder>

@{
    ViewData["Title"] = "Lab Management";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="text-primary fw-bold"><i class="bi bi-clipboard-pulse"></i> Lab Management</h2>
            <p class="text-muted">Track and process patient diagnostic tests.</p>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-secondary">
                        <tr>
                            <th class="ps-4">Test Name</th>
                            <th>Patient</th>
                            <th>Order Date</th>
                            <th>Payment Status</th>
                            <th>Current Status</th>
                            <th class="text-center pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">@order.TestName</td>
                                <td>@order.Appointment.Patient.FullName</td>
                                <td>@order.OrderDate.ToString("g")</td>
                                <td>
                                    @if(order.IsPaid)
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check-circle"></i> Paid</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger"><i class="bi bi-x-circle"></i> Unpaid</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge @(order.Status == "Pending" ? "bg-warning text-dark" : "bg-success")">
                                        @order.Status
                                    </span>
                                </td>
                                <td class="text-center pe-4">
                                    <a asp-action="UpdateStatus" asp-route-id="@order.LabOrderId" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil-square"></i> Update Results
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
