@model BillingSystem.ViewModels.PatientProfileVM

@{
    ViewData["Title"] = "Patient Profile - " + Model.Patient.FullName;
}

<div class="container-fluid py-4 min-vh-100 bg-light bg-opacity-50">
    <!-- Modern Header -->
    <div class="row mb-4 align-items-center">
        <div class="col-md-7">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-muted">Dashboard</a></li>
                    <li class="breadcrumb-item active fw-medium">Patient Details</li>
                </ol>
            </nav>
            <div class="d-flex align-items-center">
                <div class="bg-primary bg-opacity-10 p-2 rounded-3 me-3">
                    <i class="bi bi-person-badge-fill text-primary fs-3"></i>
                </div>
                <h2 class="fw-bold mb-0 text-dark">@Model.Patient.FullName</h2>
            </div>
        </div>
        <div class="col-md-5">
            <div class="d-flex gap-2 justify-content-md-end mt-3 mt-md-0">
                <form asp-action="Delete" asp-route-id="@Model.Patient.PatientId" method="post" onsubmit="return confirm('Permanently delete this patient?');">
                    <button type="submit" class="btn btn-danger fw-bold px-4 rounded-pill shadow-sm transition-up">
                        <i class="bi bi-trash-fill me-2"></i> Delete Patient
                    </button>
                </form>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-4 py-3 mb-4 animate__animated animate__fadeInDown">
            <div class="d-flex align-items-center">
                <i class="bi bi-check-circle-fill fs-4 me-3"></i>
                <div>@TempData["SuccessMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm rounded-4 py-3 mb-4 animate__animated animate__fadeInDown">
            <div class="d-flex align-items-center">
                <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                <div>@TempData["ErrorMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Sticky Sidebar -->
        <div class="col-xl-3">
            <div class="sticky-top" style="top: 1.5rem; z-index: 10;">
                <!-- Profile Summary Card -->
                <div class="card border-0 shadow-sm overflow-hidden mb-4" style="border-radius: 24px;">
                    <div class="card-body p-0">
                        <div class="p-4 text-center @(Model.Patient.IsActive ? "bg-primary bg-opacity-10" : "bg-danger bg-opacity-10")">
                            <div class="position-relative d-inline-block mb-3">
                                <div class="bg-white p-1 rounded-circle shadow-sm">
                                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                                        <i class="bi bi-person fs-1"></i>
                                    </div>
                                </div>
                                @if (Model.IsAdmitted)
                                {
                                    <span class="position-absolute bottom-0 end-0 translate-middle p-1 bg-danger border border-light rounded-circle shadow pulse-danger" title="In-Patient"></span>
                                }
                            </div>
                            <h4 class="fw-bold text-dark mb-1">@Model.Patient.FullName</h4>
                            <p class="text-muted small mb-0"><i class="bi bi-upc me-1"></i> PID: #@Model.Patient.PatientId</p>
                        </div>
                        <div class="p-4 bg-white">
                            <div class="d-flex flex-column gap-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-muted small">Status</span>
                                    <span class="badge @(Model.Patient.IsActive ? "bg-success" : "bg-danger") bg-opacity-10 text-@(Model.Patient.IsActive ? "success" : "danger") rounded-pill px-3">
                                        @(Model.Patient.IsActive ? "Active" : "Archived")
                                    </span>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span class="text-muted small">Contact</span>
                                    <span class="text-dark small fw-medium">@Model.Patient.MobileNumber</span>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span class="text-muted small">Demographics</span>
                                    <span class="text-dark small fw-medium">@Model.Patient.Gender, @Model.Patient.Age yrs</span>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span class="text-muted small">Registration</span>
                                    <span class="text-dark small fw-medium">@Model.Patient.CreatedDate.ToString("MMM yyyy")</span>
                                </div>
                            </div>

                            <hr class="my-4 opacity-10">

                            <!-- Visual Finance Stats -->
                            <div class="financial-widget p-3 rounded-4 bg-light border border-white shadow-inner">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h6 class="fw-bold mb-0 text-muted small text-uppercase ls-1">Outstanding</h6>
                                    <div class="bg-danger bg-opacity-10 p-1 rounded-circle">
                                        <i class="bi bi-wallet2 text-danger small"></i>
                                    </div>
                                </div>
                                <h3 class="fw-bold text-dark mb-1">@Model.TotalOutstanding.ToString("C0")</h3>
                                <div class="progress mb-2" style="height: 6px; border-radius: 10px;">
                                    @{
                                        var ratio = Model.TotalOutstanding > 0 ? (Model.TotalUnpaidAmount / Model.TotalOutstanding) * 100 : 0;
                                    }
                                    <div class="progress-bar bg-danger" role="progressbar" style="width: @ratio.ToString("F0")%"></div>
                                </div>
                                <div class="d-flex justify-content-between x-small">
                                    <span class="text-muted">Unpaid: @Model.TotalUnpaidAmount.ToString("C0")</span>
                                    <span class="text-muted">Pending: @Model.PendingCharges.ToString("C0")</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Quick Stats -->
                <div class="row g-3">
                    <div class="col-6">
                        <div class="card border-0 shadow-sm p-3 text-center" style="border-radius: 20px;">
                            <h5 class="fw-bold text-primary mb-0">@Model.TotalVisits</h5>
                            <small class="text-muted x-small text-uppercase fw-medium">Total Visits</small>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="card border-0 shadow-sm p-3 text-center" style="border-radius: 20px;">
                            <h5 class="fw-bold @(Model.IsAdmitted ? "text-danger" : "text-muted") mb-0">@(Model.IsAdmitted ? "IPD" : "OPD")</h5>
                            <small class="text-muted x-small text-uppercase fw-medium">Current Plan</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Tabbed Content -->
        <div class="col-xl-9">
            <div class="card border-0 shadow-sm overflow-hidden" style="border-radius: 24px;">
                <div class="card-header bg-white border-0 p-3 p-md-4">
                    <ul class="nav nav-pills custom-pills gap-2" id="patientTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active rounded-pill px-4 py-2 fw-medium" id="history-tab" data-bs-toggle="pill" data-bs-target="#history" type="button" role="tab">
                                <i class="bi bi-clock-history me-2"></i> Visit History
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link rounded-pill px-4 py-2 fw-medium" id="labs-tab" data-bs-toggle="pill" data-bs-target="#labs" type="button" role="tab">
                                <i class="bi bi-microscope me-2"></i> Diagnostics
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link rounded-pill px-4 py-2 fw-medium position-relative" id="admission-tab" data-bs-toggle="pill" data-bs-target="#admission" type="button" role="tab">
                                <i class="bi bi-hospital me-2"></i> Admission
                                @if (Model.IsAdmitted)
                                {
                                    <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle"></span>
                                }
                            </button>
                        </li>
                    </ul>
                </div>
                <div class="card-body p-0">
                    <div class="tab-content" id="patientTabsContent">
                        <!-- History Tab -->
                        <div class="tab-pane fade show active" id="history" role="tabpanel">
                            <div class="p-4 d-flex justify-content-between align-items-center">
                                <h5 class="fw-bold mb-0 text-dark">Recent Consultations</h5>
                                <a asp-controller="Appointment" asp-action="Create" asp-route-patientId="@Model.Patient.PatientId" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)" class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm hover-scale">
                                    <i class="bi bi-plus-lg me-1"></i> Log New Visit
                                </a>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0 custom-table">
                                    <thead class="bg-light text-muted x-small text-uppercase fw-bold">
                                        <tr>
                                            <th class="ps-4 py-3">Visit Date</th>
                                            <th class="py-3">Physician</th>
                                            <th class="py-3">Clinical Reason</th>
                                            <th class="py-3">Status</th>
                                            <th class="text-end pe-4 py-3">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (!Model.Appointments.Any())
                                        {
                                            <tr><td colspan="5" class="text-center py-5 text-muted small"><i class="bi bi-inbox fs-2 d-block mb-2"></i> No records found.</td></tr>
                                        }
                                        @foreach (var appt in Model.Appointments)
                                        {
                                            <tr class="transition-all">
                                                <td class="ps-4">
                                                    <div class="fw-bold text-dark">@appt.AppointmentDate.ToString("dd MMM yyyy")</div>
                                                    <small class="text-muted">@appt.AppointmentTime.ToString(@"hh\:mm") @(DateTime.Today.Add(appt.AppointmentTime).ToString("tt"))</small>
                                                </td>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <div class="avatar-sm me-2 bg-info bg-opacity-10 text-info rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                                            <i class="bi bi-person-heart"></i>
                                                        </div>
                                                        <span class="fw-medium">@appt.DoctorName</span>
                                                    </div>
                                                </td>
                                                <td class="small text-truncate" style="max-width: 250px;">@appt.Reason</td>
                                                <td>
                                                    <span class="badge @(appt.Status == "Scheduled" ? "bg-primary" : appt.Status == "Completed" ? "bg-success" : "bg-danger") bg-opacity-10 text-@(appt.Status == "Scheduled" ? "primary" : appt.Status == "Completed" ? "success" : "danger") rounded-pill px-3">
                                                        @appt.Status
                                                    </span>
                                                </td>
                                                <td class="text-end pe-4">
                                                    <a asp-controller="Appointment" asp-action="Details" asp-route-id="@appt.AppointmentId" class="btn btn-sm btn-light rounded-pill px-3 transition-up">View Case</a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Labs Tab -->
                        <div class="tab-pane fade" id="labs" role="tabpanel">
                            <div class="p-4 d-flex justify-content-between align-items-center">
                                <h5 class="fw-bold mb-0 text-dark">Diagnostic History</h5>
                                @{ var latestAppt = Model.Appointments.FirstOrDefault(a => a.Status != "Cancelled"); }
                                @if (latestAppt != null)
                                {
                                    <a asp-controller="LabOrder" asp-action="Create" asp-route-appointmentId="@latestAppt.AppointmentId" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)" class="btn btn-sm btn-warning rounded-pill px-3 fw-bold shadow-sm hover-scale text-dark">
                                        <i class="bi bi-eyedropper me-1"></i> Order Laboratory Test
                                    </a>
                                }
                            </div>
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0 custom-table">
                                    <thead class="bg-light text-muted x-small text-uppercase fw-bold">
                                        <tr>
                                            <th class="ps-4 py-3">Diagnostic Procedure</th>
                                            <th class="py-3">Order Date</th>
                                            <th class="py-3">Phase</th>
                                            <th class="py-3">Revenue Status</th>
                                            <th class="text-end pe-4 py-3">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (!Model.LabOrders.Any())
                                        {
                                            <tr><td colspan="5" class="text-center py-5 text-muted small"><i class="bi bi-clipboard2-pulse fs-2 d-block mb-2"></i> No diagnostic records.</td></tr>
                                        }
                                        @foreach (var lab in Model.LabOrders)
                                        {
                                            <tr>
                                                <td class="ps-4">
                                                    <div class="fw-bold text-dark">@lab.TestName</div>
                                                </td>
                                                <td><small class="text-muted">Ordered on @lab.OrderDate.ToString("dd MMM")</small></td>
                                                <td>
                                                    <span class="badge @(lab.Status == "Pending" ? "bg-warning" : "bg-success") bg-opacity-10 text-@(lab.Status == "Pending" ? "secondary" : "success") rounded-pill px-3">
                                                        @lab.Status
                                                    </span>
                                                </td>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <i class="bi @(lab.IsPaid ? "bi-check-circle-fill text-success" : "bi-exclamation-circle-fill text-danger") me-2"></i>
                                                        <span class="small @(lab.IsPaid ? "text-success" : "text-danger") fw-medium">@(lab.IsPaid ? "Received" : "Awaiting Payment")</span>
                                                    </div>
                                                </td>
                                                <td class="text-end pe-4">
                                                    <form asp-controller="LabOrder" asp-action="Delete" asp-route-id="@lab.LabOrderId" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)" method="post" onsubmit="return confirm('Remove diagnostic record?');">
                                                        <button type="submit" class="btn btn-sm btn-outline-light text-muted border-0 rounded-circle transition-all"><i class="bi bi-trash"></i></button>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Admission Tab -->
                        <div class="tab-pane fade" id="admission" role="tabpanel">
                            <div class="p-4 bg-danger bg-opacity-10 border-bottom">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h5 class="fw-bold mb-0 text-danger"><i class="bi bi-hospital-fill me-2"></i> IPD - In-Patient Unit</h5>
                                    @if (!Model.IsAdmitted)
                                    {
                                        <form asp-action="Admit" asp-route-id="@Model.Patient.PatientId" method="post">
                                            <button type="submit" class="btn btn-danger btn-sm rounded-pill px-4 fw-bold shadow-sm hover-scale">
                                                <i class="bi bi-door-closed me-1"></i> Register Room Admission
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                            <!-- Active Admission Card -->
                            <div class="p-4 p-md-5 text-center @(Model.IsAdmitted ? "" : "d-none")">
                                @if (Model.IsAdmitted)
                                {
                                    <div class="admission-active-card bg-white p-4 rounded-4 shadow-sm border border-danger border-opacity-25 mx-auto" style="max-width: 600px;">
                                        <div class="row align-items-center g-4">
                                            <div class="col-md-6 border-md-end text-md-start">
                                                <small class="text-danger fw-bold text-uppercase x-small d-block mb-1">Current Registration</small>
                                                <h3 class="fw-bold text-dark mb-0">@Model.ActiveAdmission!.AdmitDate.ToString("dd MMM yyyy")</h3>
                                                <p class="text-muted mb-0">At @Model.ActiveAdmission.AdmitDate.ToString("hh:mm tt")</p>
                                            </div>
                                            <div class="col-md-6 text-md-end">
                                                @{ var dayCount = (DateTime.Now.Date - Model.ActiveAdmission.AdmitDate.Date).Days; if (dayCount < 1) dayCount = 1; }
                                                <h1 class="display-4 fw-black text-danger mb-0">@dayCount</h1>
                                                <small class="text-muted fw-bold text-uppercase x-small">Nights Registered</small>
                                            </div>
                                        </div>
                                        
                                        <hr class="my-4">
                                        
                                        <div class="d-flex gap-2 justify-content-center">
                                            <button class="btn btn-outline-secondary rounded-pill px-4" data-bs-toggle="collapse" data-bs-target="#adjustDaysContainer">
                                                <i class="bi bi-pencil-square me-1"></i> Adjust Duration
                                            </button>
                                            <form asp-action="Discharge" asp-route-id="@Model.Patient.PatientId" method="post" onsubmit="return confirm('Officially discharge this patient?');">
                                                <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold pulse-danger">
                                                    <i class="bi bi-box-arrow-right me-1"></i> Finalize Discharge
                                                </button>
                                            </form>
                                        </div>

                                        <div id="adjustDaysContainer" class="collapse mt-4">
                                            <div class="bg-light p-3 rounded-4">
                                                <form asp-action="UpdateAdmitDays" method="post" class="d-flex gap-2">
                                                    <input type="hidden" name="patientId" value="@Model.Patient.PatientId" />
                                                    <input type="number" name="days" class="form-control text-center" value="@dayCount" min="0" required />
                                                    <button type="submit" class="btn btn-primary px-4">Update</button>
                                                </form>
                                                <small class="text-muted mt-2 d-block italic x-small">Changes room rent calculations immediately</small>
                                            </div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="py-5">
                                        <div class="bg-light bg-opacity-50 p-5 rounded-fill-soft d-inline-block mb-4">
                                            <i class="bi bi-house-door text-muted display-4"></i>
                                        </div>
                                        <h4 class="fw-bold text-dark">No Active Admission</h4>
                                        <p class="text-muted mx-auto" style="max-width: 400px;">This patient is currently classified as an Out-Patient. Start an admission to track room charges and inpatient diagnostics.</p>
                                    </div>
                                }
                            </div>
                            
                            <hr class="my-5 opacity-10">
                            
                            <div class="text-start px-4 pb-4">
                                <h6 class="fw-bold text-muted mb-3"><i class="bi bi-clock-history me-2"></i> Admission History</h6>
                                @if (Model.AdmissionHistory.Any())
                                {
                                    <div class="table-responsive">
                                        <table class="table table-hover align-middle mb-0 custom-table">
                                            <thead class="bg-light text-muted x-small text-uppercase fw-bold">
                                                <tr>
                                                    <th class="ps-4 py-2">Period</th>
                                                    <th class="py-2">Duration</th>
                                                    <th class="py-2">Status</th>
                                                    <th class="py-2 text-end pe-4">Discharge Date</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var adm in Model.AdmissionHistory)
                                                {
                                                    <tr>
                                                        <td class="ps-4">
                                                            <span class="fw-bold text-dark">@adm.AdmitDate.ToString("dd MMM yyyy")</span>
                                                        </td>
                                                        <td>@adm.AdmitDays Days</td>
                                                        <td>
                                                            @if (adm.DischargeDate == null)
                                                            {
                                                                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2">Active</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-2">Discharged</span>
                                                            }
                                                        </td>
                                                        <td class="text-end pe-4">@(adm.DischargeDate?.ToString("dd MMM yyyy") ?? "-")</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                                else
                                {
                                        <p class="text-muted small">No past admissions found.</p>
                                }
                            </div>
                            
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --primary-soft: rgba(13, 110, 253, 0.1);
        --danger-soft: rgba(220, 53, 69, 0.1);
        --success-soft: rgba(25, 135, 84, 0.1);
    }

    .ls-1 { letter-spacing: 1px; }
    .x-small { font-size: 0.72rem; }
    .fw-black { font-weight: 900; }
    
    .rounded-24 { border-radius: 24px; }
    .rounded-fill-soft { border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%; }

    .custom-pills .nav-link {
        color: #6c757d;
        background: #f8f9fa;
        border: 1px solid #e9ecef;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .custom-pills .nav-link.active {
        background: #0d6efd;
        color: white;
        border-color: #0d6efd;
        box-shadow: 0 4px 12px rgba(13, 110, 253, 0.25);
    }

    .custom-table tr {
        transition: transform 0.2s ease, background-color 0.2s ease;
    }

    .custom-table tr:hover {
        background-color: #fcfcfc !important;
        transform: scale(1.002);
    }

    .hover-scale {
        transition: transform 0.2s ease;
    }

    .hover-scale:hover {
        transform: scale(1.05);
    }

    .transition-up {
        transition: all 0.2s ease;
    }

    .transition-up:hover {
        transform: translateY(-2px);
    }

    .financial-widget {
        background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
    }

    .shadow-inner {
        box-shadow: inset 0 2px 4px rgba(0,0,0,0.02);
    }

    .pulse-danger {
        animation: pulse-red-rings 2s infinite;
    }

    @@keyframes pulse-red-rings {
        0% { box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.4); }
        70% { box-shadow: 0 0 0 10px rgba(220, 53, 69, 0); }
        100% { box-shadow: 0 0 0 0 rgba(220, 53, 69, 0); }
    }

    .sticky-top {
        transition: top 0.3s ease;
    }

    @@media (min-width: 768px) {
        .border-md-end { border-right: 1px solid #dee2e6 !important; }
    }

    /* Professional Hospital Palettes */
    body {
        background-color: #f4f7f6;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
    }
</style>
