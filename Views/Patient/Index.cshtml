@model BillingSystem.ViewModels.PatientDashboardListVM

@{
    ViewData["Title"] = "Patient Management";
}

<div class="container-fluid py-4">
    <!-- Standard Dashboard Header -->
    <div class="row align-items-center mb-4">
        <div class="col-md-8">
            <h2 class="fw-bold text-primary"><i class="bi bi-people-fill"></i> Patient Management</h2>
            <p class="text-muted mb-0">Total Patients: <span class="badge bg-primary rounded-pill">@Model.TotalPatientsCount</span> | Upcoming Appointments: <span class="badge bg-success rounded-pill">@Model.UpcomingAppointmentsCount</span></p>
        </div>
        <div class="col-md-4 text-md-end mt-3 mt-md-0">
            <a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus-fill"></i> Register New Patient</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search Tool -->
    <div class="card shadow-sm border-0 mb-4 bg-light">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="searchString" value="@ViewBag.CurrentFilter" class="form-control border-start-0" placeholder="Search by name, ID or mobile...">
                        <button type="submit" class="btn btn-primary">Search</button>
                        @if (!string.IsNullOrEmpty(ViewBag.CurrentFilter))
                        {
                            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
                        }
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Patient Cards Grid -->
    <div class="row g-4">
        @if (!Model.Patients.Any())
        {
            <div class="col-12 text-center py-5">
                <i class="bi bi-person-x fs-1 text-muted opacity-50"></i>
                <h4 class="mt-3 text-muted">No patients found</h4>
            </div>
        }
        
        @foreach (var patient in Model.Patients)
        {
            <div class="col-sm-6 col-lg-4 col-xl-3">
                <div class="card h-100 shadow-sm border-0 hover-shadow transition" style="border-radius: 15px;">
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-3">
                            <div class="@(patient.IsActive ? "bg-primary" : "bg-danger") bg-opacity-10 text-@(patient.IsActive ? "primary" : "danger") rounded-3 d-flex align-items-center justify-content-center" style="width: 45px; height: 45px;">
                                <i class="bi bi-person-fill fs-4"></i>
                            </div>
                        </div>

                        <h5 class="card-title fw-bold mb-1">
                            @patient.FullName
                            @if (!patient.IsActive)
                            {
                                <span class="badge bg-danger rounded-pill x-small ms-1" style="font-size: 0.6rem;">Deleted Profile</span>
                            }
                        </h5>
                        <p class="text-muted small mb-3">ID: #@patient.PatientId | @patient.AgeGender</p>

                        <div class="mb-3 p-2 bg-light rounded-3">
                            <label class="d-block small fw-bold text-uppercase text-muted mb-1" style="font-size: 0.7rem;">Upcoming Appointment</label>
                            @if (patient.HasUpcomingAppointment)
                            {
                                <div class="d-flex align-items-center justify-content-between">
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">
                                        <i class="bi bi-dot pulse"></i> @patient.NextAppointmentDisplay
                                    </span>
                                    <form asp-controller="Appointment" asp-action="Delete" asp-route-id="@patient.AppointmentId" method="post" onsubmit="return confirm('Cancel appointment?');">
                                        <button type="submit" class="btn btn-sm text-danger p-0 ms-2" title="Delete Appointment">
                                            <i class="bi bi-x-circle-fill"></i>
                                        </button>
                                    </form>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex align-items-center justify-content-between text-muted small">
                                    <span>None scheduled</span>
                                    <a asp-controller="Appointment" asp-action="Create" asp-route-patientId="@patient.PatientId" class="btn btn-sm btn-link p-0 text-primary" title="Book Now">
                                        <i class="bi bi-plus-circle-fill"></i>
                                    </a>
                                </div>
                            }
                        </div>

                        @if (patient.IsActive)
                        {
                            <div class="mt-4 d-flex gap-2">
                                <a asp-action="Details" asp-route-id="@patient.PatientId" class="btn btn-primary flex-grow-1 rounded-pill fw-bold btn-sm py-2">
                                    <i class="bi bi-person-lines-fill me-1"></i> View Profile
                                </a>
                                @if (!User.IsInRole("Admin"))
                                {
                                    <a asp-controller="LabOrder" asp-action="Index" asp-route-searchString="@patient.PatientId" class="btn btn-outline-primary flex-grow-1 rounded-pill fw-bold btn-sm py-2">
                                        <i class="bi bi-file-earmark-medical"></i> Reports
                                    </a>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="mt-4">
                                <form asp-action="Activate" asp-route-id="@patient.PatientId" method="post">
                                    <button type="submit" class="btn btn-success w-100 rounded-pill fw-bold btn-sm py-2">
                                        <i class="bi bi-arrow-counterclockwise"></i> Reactivate Patient Account
                                    </button>
                                </form>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .hover-shadow:hover { 
        box-shadow: 0 .5rem 1.5rem rgba(0,0,0,.08)!important;
        transform: translateY(-3px);
    }
    .transition { transition: all 0.3s ease; }
    .pulse {
        animation: pulse-green 2s infinite;
        border-radius: 50%;
    }
    @@keyframes pulse-green {
        0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(40, 167, 69, 0.7); }
        70% { transform: scale(1); box-shadow: 0 0 0 10px rgba(40, 167, 69, 0); }
        100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(40, 167, 69, 0); }
    }
</style>
