@model BillingSystem.ViewModels.PatientRegistrationVM

@{
    ViewData["Title"] = "Patient Registration";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <h3 class="card-title mb-0">Patient Registration</h3>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <!-- Personal Details -->
                    <h5 class="border-bottom pb-2 mb-3">Personal Details</h5>
                    <div class="row mb-3">
                        <div class="col-md-3">
                            <label asp-for="FirstName" class="form-label"></label>
                            <input asp-for="FirstName" class="form-control" placeholder="First Name" />
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="LastName" class="form-label"></label>
                            <input asp-for="LastName" class="form-control" placeholder="Last Name" />
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                             <label asp-for="MobileNumber" class="form-label"></label>
                            <input asp-for="MobileNumber" class="form-control" placeholder="10-digit number" />
                            <span asp-validation-for="MobileNumber" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label asp-for="DateOfBirth" class="form-label"></label>
                            <input asp-for="DateOfBirth" class="form-control" type="date" />
                            <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                            <small class="text-muted">Senior discount apply automatically based on DOB.</small>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Gender" class="form-label"></label>
                            <select asp-for="Gender" asp-items="Html.GetEnumSelectList<BillingSystem.Models.Gender>()" class="form-select">
                                <option value="">-- Select Gender --</option>
                            </select>
                            <span asp-validation-for="Gender" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" type="email" placeholder="Optional" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Admission & Metadata -->
                    <h5 class="border-bottom pb-2 mb-3 mt-4">Other Details</h5>
                    <div class="row mb-3">
                        <div class="col-md-3">
                            <label asp-for="AdmitDays" class="form-label"></label>
                            <input asp-for="AdmitDays" class="form-control" type="number" min="0" />
                            <span asp-validation-for="AdmitDays" class="text-danger"></span>
                            <small class="text-muted">Enter 0 for OPD.</small>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="InsuranceProvider" class="form-label"></label>
                            <input asp-for="InsuranceProvider" class="form-control" placeholder="e.g. Star Health" />
                            <span asp-validation-for="InsuranceProvider" class="text-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="PolicyNumber" class="form-label"></label>
                            <input asp-for="PolicyNumber" class="form-control" placeholder="e.g. SH-3001" />
                            <span asp-validation-for="PolicyNumber" class="text-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="CreatedBy" class="form-label"></label>
                            <input asp-for="CreatedBy" class="form-control" placeholder="Staff Name" />
                            <span asp-validation-for="CreatedBy" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-grid gap-2 mt-5">
                        <button type="submit" class="btn btn-success btn-lg">Complete Registration</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Back to Dashboard</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
